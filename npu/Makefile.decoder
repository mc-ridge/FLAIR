#
# Authors: Daniel Eyraud, Mary-Claire Ridgeway
#
# Builds the decoder AIE design and instruction stream in WSL, the Windows
# XRT host executable, and the generated input and golden-result buffers.
# The unfused decoder returns the hidden sequence; reconstruction and anomaly
# scoring remain host-side.
#
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))

include ${srcdir}/../../makefile-common

targetname = gru_decoder
aie_py_src = gru_decoder.py
devicename = npu

HIDDEN_DIM ?= 64
SEQ_LEN ?= 10
N_PARAMS ?= 24960
WINDOW_INDEX ?= 0
BATCH ?= 1  # windows per kernel invocation; params stay a single shared copy

# Forward optional XRT installation paths to the Windows host build.
XRT_FLAGS =
ifdef XRT_INC_DIR
XRT_FLAGS += -DXRT_INC_DIR=`${getwslpath} ${XRT_INC_DIR}`
endif
ifdef XRT_LIB_DIR
XRT_FLAGS += -DXRT_LIB_DIR=`${getwslpath} ${XRT_LIB_DIR}`
endif

xclbin_target = build/decoder.xclbin
insts_target = build/decoder_insts.bin

.PHONY: all
all: ${xclbin_target} ${insts_target} data

# Compile the IRON design into the xclbin and instruction stream.
$(eval $(call jit_xclbin,${xclbin_target},${insts_target},${aie_py_src},--dev ${devicename} --hidden-dim ${HIDDEN_DIM} --seq-len ${SEQ_LEN} --batch ${BATCH}))

# jit_xclbin tracks the Python wrapper by default; list the included C++
# sources so decoder-kernel or shared-GRU changes also rebuild the design.
${xclbin_target} ${insts_target}: ${srcdir}/kernels/gru_decoder.cc ${srcdir}/kernels/gru_common.h

# Build the fixed-size Windows XRT host for the decoder configuration.
$(eval $(call build_host_exe,${targetname},_build,tests/test_decoder.cpp,${XRT_FLAGS} -DNPU_MODE=decoder -DINPUT_DIM=${HIDDEN_DIM} -DHIDDEN_DIM=${HIDDEN_DIM} -DSEQ_LEN=${SEQ_LEN} -DN_PARAMS=${N_PARAMS}))

# Generate the selected decoder input, packed parameters, and golden outputs.
.PHONY: data
data:
	python3 ${srcdir}/tests/gen_decoder_data.py --seq-len ${SEQ_LEN} --window-index ${WINDOW_INDEX}

.PHONY: run
run: ${targetname}.exe ${xclbin_target} ${insts_target} data
	${powershell} ./$< -x ${xclbin_target} -i ${insts_target} -k MLIR_AIE -v 1

# Apply hidden_to_output and MSE to the NPU hidden sequence, then compare the
# resulting anomaly score with the PyTorch-precision reference.
.PHONY: score
score:
	python3 ${srcdir}/tests/compare_anomaly_score.py --seq-len ${SEQ_LEN} --window-index ${WINDOW_INDEX}

.PHONY: clean
clean:
	rm -rf build _build ${targetname}*.exe \
	decoder_h0.bin decoder_gru_params.bin decoder_hidden_golden.bin \
	decoder_latent.bin decoder_params.bin decoder_x_num.bin \
	decoder_golden_recon.bin decoder_golden_score.bin decoder_npu_hidden.bin
