#
# Authors: Daniel Eyraud, Mary-Claire Ridgeway
#
# Builds the encoder AIE design and instruction stream in WSL, the Windows
# XRT host executable, and the generated input and golden-result buffers.
#
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception

srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))

include ${srcdir}/../../makefile-common

targetname = gru_encoder
aie_py_src = gru_encoder.py

# Phoenix/XDNA1 target used by the encoder design.
devicename = npu

# INPUT_DIM includes padding from 45 to 48 features for 16-lane matvecs.
INPUT_DIM ?= 48
HIDDEN_DIM ?= 64
SEQ_LEN ?= 10
N_PARAMS ?= 21888  # 3*H*(INPUT_DIM+H)+2*3*H with INPUT_DIM=48 (padded)
BATCH ?= 1  # windows per kernel invocation

# Forward optional XRT installation paths to the Windows host build.
XRT_FLAGS =
ifdef XRT_INC_DIR
XRT_FLAGS += -DXRT_INC_DIR=`${getwslpath} ${XRT_INC_DIR}`
endif
ifdef XRT_LIB_DIR
XRT_FLAGS += -DXRT_LIB_DIR=`${getwslpath} ${XRT_LIB_DIR}`
endif

xclbin_target = build/gru.xclbin
insts_target = build/insts.bin

.PHONY: all
all: ${xclbin_target} ${insts_target} data

# Compile the IRON design into the xclbin and instruction stream.
$(eval $(call jit_xclbin,${xclbin_target},${insts_target},${aie_py_src},--dev ${devicename} --input-dim ${INPUT_DIM} --hidden-dim ${HIDDEN_DIM} --seq-len ${SEQ_LEN} --batch ${BATCH}))

# jit_xclbin tracks the Python wrapper by default; list the included C++
# sources so kernel or shared-GRU changes also rebuild the design.
${xclbin_target} ${insts_target}: ${srcdir}/kernels/gru_encoder.cc ${srcdir}/kernels/gru_common.h

# (ii) Build the host test.exe (Windows, via cmake/powershell).
$(eval $(call build_host_exe,${targetname},_build,test.cpp,${XRT_FLAGS} -DNPU_MODE=encoder -DINPUT_DIM=${INPUT_DIM} -DHIDDEN_DIM=${HIDDEN_DIM} -DSEQ_LEN=${SEQ_LEN} -DN_PARAMS=${N_PARAMS}))

# Generate the encoder input, packed parameters, and golden latent output.
.PHONY: data
data: gru_golden.bin
gru_state.bin gru_params.bin gru_golden.bin &: tests/gen_encoder_data.py
	python3 ${srcdir}/tests/gen_encoder_data.py --seq-len ${SEQ_LEN}

.PHONY: run
run: ${targetname}.exe ${xclbin_target} ${insts_target} data
	${powershell} ./$< -x ${xclbin_target} -i ${insts_target} -k MLIR_AIE -v 1

.PHONY: clean
clean:
	rm -rf build _build ${targetname}*.exe gru_state.bin gru_params.bin gru_golden.bin
